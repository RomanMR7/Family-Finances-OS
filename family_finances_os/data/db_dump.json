{
  "schema": {
    "system_meta": "CREATE TABLE system_meta (\n            key TEXT PRIMARY KEY,\n            value TEXT NOT NULL,\n            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n        )",
    "users": "CREATE TABLE users (\n            id TEXT PRIMARY KEY,\n            username TEXT UNIQUE NOT NULL,\n            display_name TEXT NOT NULL,\n            role TEXT NOT NULL CHECK(role IN ('OWNER', 'ADULT', 'CHILD', 'VIEWER')),\n            password_hash BLOB NOT NULL,\n            salt BLOB NOT NULL,\n            is_active INTEGER NOT NULL DEFAULT 1,\n            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n        )",
    "members": "CREATE TABLE members (\n            id TEXT PRIMARY KEY,\n            user_id TEXT REFERENCES users(id) ON DELETE SET NULL,\n            display_name TEXT NOT NULL,\n            role TEXT NOT NULL CHECK(role IN ('OWNER', 'ADULT', 'CHILD', 'VIEWER')),\n            color_hex TEXT DEFAULT '#2563EB',\n            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n        )",
    "accounts": "CREATE TABLE accounts (\n            id TEXT PRIMARY KEY,\n            code TEXT UNIQUE,\n            name TEXT NOT NULL,\n            account_type TEXT NOT NULL CHECK(account_type IN ('ASSET', 'LIABILITY', 'EQUITY', 'INCOME', 'EXPENSE')),\n            subtype TEXT NOT NULL,  -- 'CASH', 'DEBIT_CARD', 'SAVINGS', 'CREDIT_CARD', 'LOAN', 'COMMON_EQUITY', etc.\n            currency TEXT NOT NULL DEFAULT 'RUB',\n            ownership_scope TEXT NOT NULL CHECK(ownership_scope IN ('COMMON', 'PERSONAL_HUSBAND', 'PERSONAL_WIFE', 'PERSONAL_CHILD')),\n            owner_member_id TEXT REFERENCES members(id) ON DELETE SET NULL,\n            is_active INTEGER NOT NULL DEFAULT 1,\n            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n        , description TEXT, credit_limit_cents INTEGER NOT NULL DEFAULT 0, initial_balance_cents INTEGER NOT NULL DEFAULT 0)",
    "categories": "CREATE TABLE categories (\n            id TEXT PRIMARY KEY,\n            name TEXT NOT NULL,\n            category_type TEXT NOT NULL CHECK(category_type IN ('INCOME', 'EXPENSE')),\n            parent_id TEXT REFERENCES categories(id) ON DELETE CASCADE,\n            is_active INTEGER NOT NULL DEFAULT 1\n        )",
    "transactions": "CREATE TABLE transactions (\n            id TEXT PRIMARY KEY,\n            tx_date TEXT NOT NULL,\n            tx_type TEXT NOT NULL CHECK(tx_type IN ('INCOME', 'EXPENSE', 'TRANSFER', 'LOAN_ISSUE', 'LOAN_REPAYMENT', 'CREDIT_PURCHASE', 'CREDIT_PAYMENT', 'REFUND', 'ADJUSTMENT')),\n            description TEXT NOT NULL,\n            created_by_member_id TEXT REFERENCES members(id),\n            is_voided INTEGER NOT NULL DEFAULT 0,\n            voided_reason TEXT,\n            reversal_of_id TEXT REFERENCES transactions(id),\n            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n        , payload_hash TEXT, idempotency_key TEXT)",
    "postings": "CREATE TABLE postings (\n            id TEXT PRIMARY KEY,\n            transaction_id TEXT NOT NULL REFERENCES transactions(id) ON DELETE CASCADE,\n            account_id TEXT NOT NULL REFERENCES accounts(id),\n            amount_cents INTEGER NOT NULL CHECK(amount_cents > 0),\n            posting_type TEXT NOT NULL CHECK(posting_type IN ('DEBIT', 'CREDIT')),\n            ownership_scope TEXT NOT NULL CHECK(ownership_scope IN ('COMMON', 'PERSONAL_HUSBAND', 'PERSONAL_WIFE', 'PERSONAL_CHILD')),\n            purpose_allocation TEXT NOT NULL DEFAULT 'SAFE_TO_SPEND' CHECK(purpose_allocation IN ('SAFE_TO_SPEND', 'EMERGENCY_FUND', 'GOAL_BUCKET', 'RESERVE')),\n            note TEXT,\n            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n        )",
    "change_log": "CREATE TABLE change_log (\n            local_seq INTEGER PRIMARY KEY AUTOINCREMENT,\n            entity_name TEXT NOT NULL,\n            entity_id TEXT NOT NULL,\n            change_type TEXT NOT NULL CHECK(change_type IN ('INSERT', 'UPDATE', 'DELETE')),\n            payload_json TEXT NOT NULL,\n            device_id TEXT NOT NULL,\n            updated_at_utc TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n        )",
    "sqlite_sequence": "CREATE TABLE sqlite_sequence(name,seq)"
  },
